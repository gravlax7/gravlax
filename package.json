  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "audit": "bun audit --audit-level=high",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "install-electron": "node scripts/install-electron.cjs",
    "postinstall": "node scripts/install-electron.cjs",
    "fixture:tagging": "bun run scripts/generate-tagging-fixture.ts",
    "release": "bun run scripts/release.ts",
    "dist": "bun run build && electron-builder",
    "dist:mac": "bun run build && electron-builder --mac",
    "dist:linux": "bun run build && electron-builder --linux",
    "dist:win": "bun run build && electron-builder --win"
  },
  "dependencies": {
    "@solidjs/web": "2.0.0",
    "bencode": "^4.0.1",
    "create-torrent": "^6.1.3",
    "node-html-parser": "^9.0.7",
    "node-id3": "^0.2.9",
    "sanitize-html": "^2.18.1",
    "smol-toml": "^1.9.1",
    "solid-js": "2.0.0",
    "ssh2": "^1.17.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@solidjs/vite-plugin": "3.0.1",
    "@types/node": "^24.19.2",
    "@types/sanitize-html": "^2.16.2",
    "@types/ssh2": "^1.15.6",
    "electron": "^45.2.3",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.7",
    "vitest": "^5.1.0"
  }
}
